	partition dim_split = m
		mode: import
		source =
				let
				    Source =
				        if DataSource = "PostgreSQL" then
				            PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "dim_split"]}[Data]
				        else
				            Table.PromoteHeaders(
				                Csv.Document(File.Contents(CsvFolder & "dim_split.csv"),
				                    [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				                [PromoteAllScalars = true]),
				    #"Parsed booleans" = if DataSource = "PostgreSQL" then Source else Table.TransformColumns(Source, {{"is_evaluation", each if _ = null then null else Text.Lower(_) = "true" or _ = "t"}}),
				    #"Typed columns" = Table.TransformColumnTypes(#"Parsed booleans", {{"dataset_split", type text}, {"split_label", type text}, {"sort_key", Int64.Type}, {"is_evaluation", type logical}, {"description", type text}}, "en-US")
				in
				    #"Typed columns"

	annotation PBI_ResultType = Table
