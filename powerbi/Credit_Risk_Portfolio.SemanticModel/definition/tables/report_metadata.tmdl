	partition report_metadata = m
		mode: import
		source =
				let
				    Source =
				        if DataSource = "PostgreSQL" then
				            PostgreSQL.Database(PgServer, PgDatabase){[Schema = "mart", Item = "v_report_metadata"]}[Data]
				        else
				            Table.PromoteHeaders(
				                Csv.Document(File.Contents(CsvFolder & "v_report_metadata.csv"),
				                    [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				                [PromoteAllScalars = true]),
				    #"Parsed booleans" = if DataSource = "PostgreSQL" then Source else Table.TransformColumns(Source, {{"is_synthetic", each if _ = null then null else Text.Lower(_) = "true" or _ = "t"}}),
				    #"Typed columns" = Table.TransformColumnTypes(#"Parsed booleans", {{"last_refreshed", type datetime}, {"model_version", type text}, {"algorithm", type text}, {"calibration_method", type text}, {"selected_threshold", type number}, {"trained_at", type datetime}, {"population_customers", Int64.Type}, {"population_note", type text}, {"base_lgd", type number}, {"is_synthetic", type logical}}, "en-US")
				in
				    #"Typed columns"

	annotation PBI_ResultType = Table
